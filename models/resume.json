{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Résumé d’un article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Résumé seul de l’article, en 30 mots maximum, dans la langue demandée."
    }
  }
}
