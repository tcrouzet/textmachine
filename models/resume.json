{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Résumés et revue de presse",
  "description": "Chaque article sélectionné apparaît exactement une fois, avec son titre traduit et son résumé.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "description": "Revue de presse regroupée par thème. Chaque ID retenu apparaît une seule fois.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "articles"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "summary"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "description": "Titre de l’article dans la langue demandée. Reprendre le titre original si aucune traduction n’est nécessaire.",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
