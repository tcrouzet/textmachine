{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rédaction de l’article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "chapeau",
    "paragraphs"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la newsletter, sans date ni mention de TextMachine.",
      "minLength": 1
    },
    "chapeau": {
      "type": "string",
      "description": "Introduction de moins de 25 mots.",
      "minLength": 1
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Paragraphes de l’article de synthèse, avec liens et citations en Markdown. Au moins deux paragraphes si des articles sont retenus.",
      "minItems": 2
    }
  }
}
