{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rédaction de l’article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paragraphs"
  ],
  "properties": {
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Paragraphes du corps de l’article en Markdown, avec liens et citations, sans titre, chapeau, image ni revue de presse.",
      "minItems": 2
    }
  }
}
